# --- Google service account (server-only, never exposed to the browser) ---

# The "client_email" field from the service account JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=event-gallery@your-project.iam.gserviceaccount.com

# The "private_key" field from the service account JSON key.
# Keep the literal \n sequences below — do NOT replace them with real line
# breaks in this file. The app converts them to real newlines at runtime.
# Wrap the whole value in double quotes exactly as shown.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQ...\n-----END PRIVATE KEY-----\n"

# The ID of the Google Drive folder the service account has been given
# "Editor" access to. This is the segment of the folder's URL after
# /folders/ — e.g. https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Optional tuning (safe defaults are used if omitted) ---

# Maximum accepted upload size per photo, in megabytes. Note this is a
# practical application limit — see the README section on Railway's
# request-duration limit for why very large files on slow connections can
# still fail regardless of this setting.
MAX_FILE_SIZE_MB=100

# Number of photos returned per gallery page.
GALLERY_PAGE_SIZE=20
