# --- Cloudinary (server-only, never exposed to the browser) ---
# Find these values in Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Only assets uploaded by this gallery tag appear in the wedding album.
CLOUDINARY_TAG=namnam-irish-wedding

# --- Optional tuning (safe defaults are used if omitted) ---
MAX_FILE_SIZE_MB=100
GALLERY_PAGE_SIZE=20
